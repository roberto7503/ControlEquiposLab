<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="860.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controlequipos.controller.EquipoController">
    <children>
        <Label layoutX="25.0" layoutY="18.0" text="Control de Equipos de Laboratorio">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Columna Izquierda del Formulario -->
        <Label layoutX="25.0" layoutY="65.0" text="Código:" />
        <TextField fx:id="txtCodigo" layoutX="85.0" layoutY="60.0" prefWidth="240.0" promptText="Ej. EQ-001" />

        <Label layoutX="25.0" layoutY="105.0" text="Nombre:" />
        <TextField fx:id="txtNombre" layoutX="85.0" layoutY="100.0" prefWidth="240.0" promptText="Nombre del equipo" />

        <Label layoutX="25.0" layoutY="145.0" text="Marca:" />
        <TextField fx:id="txtMarca" layoutX="85.0" layoutY="140.0" prefWidth="240.0" promptText="Marca o fabricante" />

        <!-- Columna Derecha del Formulario -->
        <Label layoutX="370.0" layoutY="65.0" text="Cantidad:" />
        <TextField fx:id="txtCantidad" layoutX="440.0" layoutY="60.0" prefWidth="240.0" promptText="Cantidad entera" />

        <Label layoutX="370.0" layoutY="105.0" text="Estado:" />
        <ComboBox fx:id="cmbEstado" layoutX="440.0" layoutY="100.0" prefWidth="240.0" promptText="Seleccionar estado" />

        <Label layoutX="370.0" layoutY="145.0" text="Tipo:" />
        <ComboBox fx:id="cmbTipoEquipo" layoutX="440.0" layoutY="140.0" prefWidth="240.0" promptText="Seleccionar tipo de equipo" />

        <!-- Botones de Acción del Formulario -->
        <Button fx:id="btnGuardar" layoutX="25.0" layoutY="190.0" mnemonicParsing="false" onAction="#guardarEquipo" prefWidth="120.0" text="Guardar" />
        <Button fx:id="btnModificar" layoutX="160.0" layoutY="190.0" mnemonicParsing="false" onAction="#modificarEquipo" prefWidth="120.0" text="Actualizar" />
        <Button fx:id="btnEliminar" layoutX="295.0" layoutY="190.0" mnemonicParsing="false" onAction="#eliminarEquipo" prefWidth="120.0" text="Eliminar" />
        <Button fx:id="btnLimpiar" layoutX="430.0" layoutY="190.0" mnemonicParsing="false" onAction="#limpiarCampos" prefWidth="120.0" text="Limpiar" />

        <!-- Barra de Búsqueda y Filtros Combinados -->
        <Separator layoutX="25.0" layoutY="235.0" prefWidth="810.0" />

        <Label layoutX="25.0" layoutY="255.0" text="Buscar por nombre:" />
        <TextField fx:id="txtBuscarNombre" layoutX="155.0" layoutY="250.0" prefWidth="180.0" promptText="Fragmento del nombre" />

        <Label layoutX="355.0" layoutY="255.0" text="Filtrar por tipo:" />
        <ComboBox fx:id="cmbFiltroTipo" layoutX="455.0" layoutY="250.0" prefWidth="180.0" promptText="Todos los tipos" />

        <Button fx:id="btnBuscar" layoutX="650.0" layoutY="250.0" mnemonicParsing="false" onAction="#buscarYFiltrarEquipos" text="Buscar / Filtrar" />
        <Button fx:id="btnCargar" layoutX="760.0" layoutY="250.0" mnemonicParsing="false" onAction="#cargarEquipos" text="Mostrar todos" />

        <!-- TableView de Equipos -->
        <TableView fx:id="tblEquipos" layoutX="25.0" layoutY="295.0" prefHeight="330.0" prefWidth="810.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID" />
                <TableColumn fx:id="colCodigo" prefWidth="100.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="185.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="110.0" text="Marca" />
                <TableColumn fx:id="colEstado" prefWidth="130.0" text="Estado" />
                <TableColumn fx:id="colCantidad" prefWidth="75.0" text="Cantidad" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo de Equipo" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
